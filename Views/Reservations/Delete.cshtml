@model Hotel.Models.Reservation

@{
    ViewData["Title"] = "Delete Reservation";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="text-danger">@ViewData["Title"]</h1>
            <hr />

            <div class="alert alert-warning">
                <p>Are you sure you want to delete this reservation?</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Guest</dt>
                        <dd class="col-sm-9">@Model.Guest?.FullName</dd>

                        <dt class="col-sm-3">Room</dt>
                        <dd class="col-sm-9">@Model.Room?.RoomNumber</dd>

                        <dt class="col-sm-3">Check-in</dt>
                        <dd class="col-sm-9">@Model.CheckInDate.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-3">Check-out</dt>
                        <dd class="col-sm-9">@Model.CheckOutDate.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-3">Total Price</dt>
                        <dd class="col-sm-9">$@Model.TotalPrice.ToString("0.00")</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="mt-3">
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

