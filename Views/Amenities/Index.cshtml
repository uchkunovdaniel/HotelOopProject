@model List<Hotel.Models.Amenity>

@{
    ViewData["Title"] = "Amenities";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">Add New Amenity</a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No amenities found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Rooms</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var amenity in Model)
                    {
                        <tr>
                            <td>@amenity.Name</td>
                            <td>@amenity.Description</td>
                            <td>
                                <span class="badge bg-secondary">@amenity.Rooms.Count</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@amenity.Id" class="btn btn-info btn-sm">Details</a>
                                <a asp-action="Edit" asp-route-id="@amenity.Id" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="Delete" asp-route-id="@amenity.Id" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

