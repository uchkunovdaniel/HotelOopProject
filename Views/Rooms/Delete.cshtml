@model Hotel.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="text-danger">@ViewData["Title"]</h1>
            <hr />

            <div class="alert alert-warning">
                <p>Are you sure you want to delete this room?</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Room Number</dt>
                        <dd class="col-sm-9">@Model.RoomNumber</dd>

                        <dt class="col-sm-3">Type</dt>
                        <dd class="col-sm-9">@Model.Type</dd>

                        <dt class="col-sm-3">Price per Night</dt>
                        <dd class="col-sm-9">$@Model.PricePerNight.ToString("0.00")</dd>

                        <dt class="col-sm-3">Capacity</dt>
                        <dd class="col-sm-9">@Model.Capacity</dd>

                        <dt class="col-sm-3">Available</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsAvailable)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Amenities</dt>
                        <dd class="col-sm-9">
                            @if (Model.Amenities.Count > 0)
                            {
                                @foreach (var amenity in Model.Amenities)
                                {
                                    <span class="badge bg-info">@amenity.Name</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">None</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="mt-3">
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

