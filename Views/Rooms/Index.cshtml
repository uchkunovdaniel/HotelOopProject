@model List<Hotel.Models.Room>

@{
    ViewData["Title"] = "Rooms";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">Create New Room</a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No rooms found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Room Number</th>
                        <th>Type</th>
                        <th>Price per Night</th>
                        <th>Capacity</th>
                        <th>Available</th>
                        <th>Amenities</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model)
                    {
                        <tr>
                            <td>@room.RoomNumber</td>
                            <td>@room.Type</td>
                            <td>$@room.PricePerNight.ToString("0.00")</td>
                            <td>@room.Capacity</td>
                            <td>
                                @if (room.IsAvailable)
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Not Available</span>
                                }
                            </td>
                            <td>
                                @if (room.Amenities.Count > 0)
                                {
                                    @foreach (var amenity in room.Amenities.Take(2))
                                    {
                                        <span class="badge bg-info">@amenity.Name</span>
                                    }
                                    @if (room.Amenities.Count > 2)
                                    {
                                        <span class="badge bg-secondary">+@(room.Amenities.Count - 2) more</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@room.Id" class="btn btn-info btn-sm">Details</a>
                                <a asp-action="Edit" asp-route-id="@room.Id" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="Delete" asp-route-id="@room.Id" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

